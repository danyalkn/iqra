{
  "expo": {
    "name": "Iqra",
    "slug": "iqra",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-1024.png",
    "scheme": ["iqra", "device-activity"],
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.qadamtechnologies.iqra",
      "appleTeamId": "69BV989JDV",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#157f43",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.qadamtechnologies.iqra",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf8f3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0e0f0d"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-96.png",
          "color": "#157f43",
          "defaultChannel": "iqra",
          "enableRemoteNotifications": true
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "69BV989JDV",
          "appGroup": "group.com.qadamtechnologies.iqra"
        }
      ],
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "47441911-3778-4ae5-84f8-c226e9a4860f"
      }
    },
    "owner": "danyal0726",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/47441911-3778-4ae5-84f8-c226e9a4860f"
    }
  }
}
